generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Manager {
  id                   String                @id @default(uuid())
  name                 String
  email                String                @unique
  passwordHash         String
  role                 Role                  @default(MANAGER)
  branchName           String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  attendanceRecords    AttendanceRecord[]
  managerInventoryLogs ManagerInventoryLog[]
}

model DeliveryPerson {
  id                   String              @id @default(uuid())
  dpCode               String              @unique
  name                 String
  mobileNumber         String
  alternativeMobile    String?
  whatsappNumber       String?
  dateOfBirth          String?
  address              String?
  zone                 String?
  parentNameAndAddress String?
  parentOrSpouseMobile String?
  alternativeAddress   String?
  aadharNumber         String?
  licenseNumber        String?
  vehicleNumber        String?
  aadharCopyUrl        String?
  licenseCopyUrl       String?
  photoUrl             String?
  dateOfJoining        String?
  gpayNumber           String?
  upiId                String?
  bankAccountDetails   String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  role                 String              @default("Delivery Person")
  isActive             Boolean             @default(true)
  petrolBalance        Float               @default(0)
  attendanceRecords    AttendanceRecord[]
  emptyBottleLogs      EmptyBottleLog[]
  ledgerTransactions   LedgerTransaction[]
  assignedRoutes       Route[]
  routeAllocations     RouteAllocation[]
}

model Route {
  id                     String              @id @default(uuid())
  name                   String
  zone                   String
  customerCount          Int                 @default(0)
  litres                 Float               @default(0)
  assignedDpId           String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  defaultPetrolAllowance Int                 @default(0)
  emptyBottleLogs        EmptyBottleLog[]
  ledgerTransactions     LedgerTransaction[]
  assignedDp             DeliveryPerson?     @relation(fields: [assignedDpId], references: [id])
  routeAllocations       RouteAllocation[]
}

model AttendanceRecord {
  id                String           @id @default(uuid())
  dpId              String
  date              String
  status            AttendanceStatus
  markedByManagerId String
  createdAt         DateTime         @default(now())
  dp                DeliveryPerson   @relation(fields: [dpId], references: [id])
  markedByManager   Manager          @relation(fields: [markedByManagerId], references: [id])

  @@unique([dpId, date])
}

model RouteAllocation {
  id                   String                @id @default(uuid())
  routeId              String
  dpId                 String
  date                 String
  litresAllocated      Float
  status               RouteAllocationStatus
  createdAt            DateTime              @default(now())
  petrolAllowanceGiven Int?
  dp                   DeliveryPerson        @relation(fields: [dpId], references: [id])
  route                Route                 @relation(fields: [routeId], references: [id])
  items                RouteAllocationItem[]

  @@unique([routeId, dpId, date])
}

model InventoryItem {
  id                  String                 @id @default(uuid())
  name                String
  unit                String
  material            String?
  section             String?
  emptyBottleLogs     EmptyBottleLogItem[]
  dailyRecords        InventoryDailyRecord[]
  shopSaleItems       ShopSaleItem[]
  routeAllocations    RouteAllocationItem[]
}

model InventoryDailyRecord {
  id               String        @id @default(uuid())
  inventoryItemId  String
  date             String
  expectedStock    Float
  currentStock     Float
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  carriedOverStock Float?
  newStockAdded    Float?
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@unique([inventoryItemId, date])
}

model EmptyBottleLog {
  id                 String               @id @default(uuid())
  routeId            String
  dpId               String
  date               String
  deliveryCompleted  Boolean              @default(false)
  flagIssue          Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  notes              String?
  reason             String?
  dp                 DeliveryPerson       @relation(fields: [dpId], references: [id])
  route              Route                @relation(fields: [routeId], references: [id])
  items              EmptyBottleLogItem[]

  @@unique([routeId, dpId, date])
}

model DispatchDay {
  id                    String    @id @default(uuid())
  date                  String    @unique
  attendanceCompletedAt DateTime?
  inventoryCompletedAt  DateTime?
  routesCompletedAt     DateTime?
  petrolAllowanceTotal  Float     @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model LedgerTransaction {
  id        String                @id @default(uuid())
  dpId      String?
  type      LedgerTransactionType
  amount    Float
  note      String?
  date      String
  createdAt DateTime              @default(now())
  routeId   String?
  dp        DeliveryPerson?       @relation(fields: [dpId], references: [id])
  route     Route?                @relation(fields: [routeId], references: [id])
}

model ManagerInventoryLog {
  id        String   @id @default(uuid())
  date      String
  product   String
  quantity  Int
  managerId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  manager   Manager  @relation(fields: [managerId], references: [id])

  @@unique([date, product, managerId])
}

model ShopSale {
  id        String         @id @default(uuid())
  date      String         @unique // YYYY-MM-DD
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  items     ShopSaleItem[]
}

model ShopSaleItem {
  id              String @id @default(uuid())
  shopSaleId      String
  inventoryItemId String
  quantity        Int    @default(0)

  shopSale      ShopSale      @relation(fields: [shopSaleId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@unique([shopSaleId, inventoryItemId])
}

model EmptyBottleLogItem {
  id               String         @id @default(uuid())
  emptyBottleLogId String
  inventoryItemId  String
  actualDelivered  Int?
  carriedOver      Int?
  expected         Int?
  outstanding      Int?
  collected        Int?
  broken           Int?
  emptyBottleLog   EmptyBottleLog @relation(fields: [emptyBottleLogId], references: [id], onDelete: Cascade)
  inventoryItem    InventoryItem  @relation(fields: [inventoryItemId], references: [id])

  @@unique([emptyBottleLogId, inventoryItemId])
}

model RouteAllocationItem {
  id                String          @id @default(uuid())
  routeAllocationId String
  inventoryItemId   String
  quantity          Int             @default(0)
  inventoryItem     InventoryItem   @relation(fields: [inventoryItemId], references: [id])
  routeAllocation   RouteAllocation @relation(fields: [routeAllocationId], references: [id], onDelete: Cascade)

  @@unique([routeAllocationId, inventoryItemId])
}

enum Role {
  MANAGER
  ADMIN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  STANDBY
}

enum RouteAllocationStatus {
  ASSIGNED
  UNASSIGNED
  COMPLETED
}

enum LedgerTransactionType {
  SALARY
  ADVANCE
  PETROL_ALLOWANCE
  MISC
  SHORTAGE
  EXTRA_PAID
}
